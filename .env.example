# ==============================================================================
# VARIABLES DE ENTORNO - MICROSERVICIO NOTIFICACIONES TRACKVEL
# ==============================================================================
# Copia este archivo como '.env' en el servidor y completa los valores reales.
# IMPORTANTE: Nunca subas el archivo '.env' a GitHub ni a repositorios públicos.
# ==============================================================================

# ── Entorno de ASP.NET Core ───────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
EnableSwagger=true

# ── Puerto en el host (expuesto solo en 127.0.0.1:3008 para Nginx) ────────────
PORT_HOST=3008

# ── Base de datos MySQL (GTS) ────────────────────────────────────────────────
# NOTA SOBRE EL HOST:
# - Si MySQL corre directamente en el host del Droplet:
#     usa Server=host.docker.internal;Port=3306;
# - Si MySQL corre en un servidor remoto o IP pública:
#     usa Server=66.240.210.125;Port=3306;
ConnectionStrings__GtsDatabase=Server=host.docker.internal;Port=3306;Database=gts;Uid=velsatuser;Password=tu_password_aqui;Charset=utf8mb4;Pooling=true;Allow User Variables=True;MinimumPoolSize=5;MaximumPoolSize=200;ConnectionTimeout=60;ConnectionLifeTime=300;ConnectionReset=true;DefaultCommandTimeout=120;

# ── Token Maestro Permanente de la API ────────────────────────────────────────
# Token estático requerido en header 'Authorization: Bearer <token>' o 'X-API-KEY: <token>'
StaticApiToken=trackvel-static-token-2026

# ── Clave secreta para validación de tokens JWT (opcional / fallback) ────────
settings__secretkey=tu_jwt_secret_key_aqui_minimo_32_caracteres_12345

# ── Intervalo de sondeo en segundos para eventos de geocerca ─────────────────
PollingIntervalSeconds=2

# ── Orígenes permitidos para CORS (separados por coma) ────────────────────────
# Permite solicitudes de tu frontend Next.js / React y la URL pública de la API
# Usa '*' para permitir cualquier origen manteniendo soporte de SignalR credentials
AllowedOrigins=https://do.velsat.pe:8443,http://localhost:3000,http://localhost:5000

# ── Servicio de Notificaciones por WhatsApp ──────────────────────────────────
# Habilita el envío automático de WhatsApp (true / false)
WhatsApp__Enabled=true

# URL del microservicio de WhatsApp
WhatsApp__ApiUrl=https://do.velsat.pe:8443/whatsapp/api/send/single

# API Key del servicio de WhatsApp (header x-api-key)
WhatsApp__ApiKey=tu_whatsapp_api_key_aqui

# Timeout en milisegundos por solicitud HTTP a WhatsApp (default: 10000 = 10s)
WhatsApp__TimeoutMs=10000

# Pausa en milisegundos entre envíos a diferentes destinatarios (default: 400)
WhatsApp__DelayBetweenSendsMs=400
